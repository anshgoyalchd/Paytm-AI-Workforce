      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_escalated || ($json.status === 'ESCALATED')}}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-escalation",
      "name": "Is Escalated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "6046501014",
        "text": "=?? *High-Priority Escalation Alert*\n\nCase ID: `{{$json.case_id || $json.id}}`\nStatus: *{{$json.status || 'ESCALATED'}}*\nAmount Due: ?{{$json.outstanding_amount || 0}}\nReason: *{{$json.decision_reason || 'High-debt or customer dispute flagged for human review'}}*\n\nAction Required: Human collections manager review needed on Paytm Collections Dashboard.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "notify-telegram",
      "name": "Notify Escalation Team (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1050,
        200
      ]
    }
