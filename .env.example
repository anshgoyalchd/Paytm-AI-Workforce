# ==============================================================================
# Paytm AI Workforce — Autonomous AI Collections Agent
# Environment Configuration Template
# NOTE: Never commit actual credentials to version control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters_long
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Transactional Database (Supabase PostgreSQL or local SQLite for testing)
# For local offline development / unit tests:
DATABASE_URL=sqlite+aiosqlite:///./paytm_collections.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (AI Reasoning & Structured Decisions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Sarvam AI (Indian Language Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=
SARVAM_SPEECH_MODEL=saaras:v1

# Twilio (Voice Telephony & WhatsApp Messaging)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Cognee Cloud / Local Memory
COGNEE_API_KEY=
COGNEE_BASE_URL=https://api.cognee.ai

# n8n Workflow Automation
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_n8n_webhook_auth_secret

# Payment Verification (MOCKED for MVP as required by spec)
PAYMENT_VERIFICATION_PROVIDER=mock

# Policy Engine Defaults
POLICY_MAX_CONTACT_ATTEMPTS=2
POLICY_MIN_HOURS_BETWEEN_CONTACTS=4
POLICY_CONTACT_START_HOUR=9
POLICY_CONTACT_END_HOUR=19
POLICY_DEFAULT_TIMEZONE=Asia/Kolkata
